# Configuração de PRODUÇÃO (docker compose). O deploy/instalar.sh gera o .env real com segredos aleatórios.
# Nunca versione o .env.

# Domínio da plataforma: o painel e o cadastro ficam no próprio domínio e cada empresa em <empresa>.<domínio>.
PLATFORM_DOMAIN=crm.sgmulticonecta.com.br
PLATFORM_ADMIN_HOST=crm.sgmulticonecta.com.br
TENANT_SLUG=sgmulticonecta
# E-mail para o Let's Encrypt (avisos de certificado)
ACME_EMAIL=
# HTTPS: caddy (VPS só da plataforma, portas 80/443 livres) ou nginx (Nginx do servidor + deploy/certificados.sh).
HTTPS_MODO=caddy
# Com HTTPS_MODO=caddy, o perfil "caddy" sobe o servidor da frente (acrescente ",whatsapp" para o WhatsApp).
COMPOSE_PROFILES=caddy
# Porta interna (somente 127.0.0.1) do frontend: o Nginx do servidor repassa para ela e o deploy confere a saúde nela.
CRM_HTTP_PORT=8180

# Asaas (mensalidades). ASAAS_ENV=producao cobra de verdade; qualquer outro valor usa o sandbox.
ASAAS_API_KEY=
ASAAS_ENV=sandbox
# Token que o Asaas envia no webhook (openssl rand -hex 24); cadastre o mesmo no painel do Asaas.
ASAAS_WEBHOOK_TOKEN=

# openssl rand -hex 32
POSTGRES_PASSWORD=
# openssl rand -base64 48
JWT_ACCESS_SECRET=
# openssl rand -base64 32  (GUARDE UMA CÓPIA FORA DA VPS: sem ela o 2FA e a senha do SMTP não podem ser lidos)
APP_ENCRYPTION_KEY=

# Backup diário criptografado com a CHAVE PÚBLICA age (age-keygen no seu computador; a privada fica com você)
BACKUP_AGE_RECIPIENT=age1...
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
BACKUP_HOUR=3

# Primeiro administrador (usado só pelo seed)
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=

# Imagens prontas do GitHub Container Registry. Vazio = constrói na própria máquina (não recomendado na VPS de 2 GB).
CRM_IMAGE_PREFIX=ghcr.io/diegonauemocelin/saascrm

# Aviso de nova versão disponível (opcional). Ex.: diegonauemocelin/saascrm
# Repositório privado: token fine-grained somente leitura de "Contents/Metadata".
GITHUB_REPO=
GITHUB_TOKEN=

# Preenchidos automaticamente pelo deploy/deploy.sh
CRM_VERSION=
GIT_COMMIT=
BUILD_DATE=
