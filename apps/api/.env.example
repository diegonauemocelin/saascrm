# Desenvolvimento local (npm run dev:api). Em produção as variáveis vêm do docker-compose.yml.
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5173
# Banco local: npm run dev:db (PostgreSQL embutido na porta 54329) ou um Postgres próprio
DATABASE_URL=postgresql://crm:crm_dev_local@localhost:54329/crm
# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=
COOKIE_SECURE=false
UPLOAD_DIR=./storage/uploads
RELEASES_FILE=../../releases.json
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
GITHUB_REPO=
GITHUB_TOKEN=
# Plataforma (multiempresa). Vazio = só a empresa dona, em qualquer endereço. Para testar empresas no computador:
# PLATFORM_DOMAIN=saas.test e PLATFORM_ADMIN_HOST=admin.saas.test (com *.saas.test apontando para 127.0.0.1).
PLATFORM_DOMAIN=
PLATFORM_ADMIN_HOST=
# Asaas (mensalidades). ASAAS_ENV=producao cobra de verdade; qualquer outro valor usa o sandbox.
ASAAS_API_KEY=
ASAAS_ENV=sandbox
ASAAS_WEBHOOK_TOKEN=
